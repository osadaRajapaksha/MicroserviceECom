# ==============================================================================
# Microservice E-Commerce Project Configuration
# Copy this file to '.env' and fill in the values before running locally
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS CI/CD Deployment Secrets (For GitHub Actions)
# ------------------------------------------------------------------------------
# These variables should be configured as GitHub Repository Secrets to allow 
# the GitHub Actions CI/CD pipeline to deploy the application to AWS.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=microservice-ecom-frontend-xxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 2. Local Database & Service Credentials (For docker-compose.yml)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ecom_db
MYSQL_USER=admin
MYSQL_PASSWORD=password

# Keycloak Admin Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# 3. Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# The API Gateway URL that the React frontend will communicate with.
# For local development: http://localhost:8080
# For production: https://<your-api-gateway-aws-endpoint>
VITE_API_GATEWAY_URL=http://localhost:8080
